[Unit]
Description=Motocross GP live multiplayer WebSocket relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tatenda-writer
Group=tatenda-writer
WorkingDirectory=/opt/tatenda-writer/current
Environment=MOTOCROSS_RELAY_PORT=3211
ExecStart=/opt/tatenda-writer/runtime/bin/node /opt/tatenda-writer/current/tools/motocross-relay/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
