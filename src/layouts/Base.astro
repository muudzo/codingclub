---
import { site, sections, href } from '../site';
import '../styles/global.css';
import fontUrl from '../assets/fonts/sentient-variable.woff2?url';
interface Props { title?: string; description?: string; home?: boolean; noindex?: boolean; }
const { title, description = site.description, home = false, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const base = href();
const localPath = Astro.url.pathname.slice(base.length);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e2e2e2" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title || site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={[home && 'home']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header frame">
      <a class="wordmark" href={href()} aria-label={`${site.name}, home`}>{site.name}</a>
      <nav aria-label="Main navigation">
        {sections.map(section => <a href={href(`${section.id}/`)} aria-current={localPath.startsWith(`${section.id}/`) ? 'page' : undefined}>{section.title}</a>)}
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="frame footer-top">
        <p>A personal collection.<br />Always room for more.</p>
        <nav aria-label="Footer navigation">
          <a href={href()}>Home</a>
          {sections.map(section => <a href={href(`${section.id}/`)}>{section.title}</a>)}
        </nav>
      </div>
      <div class="frame"><p class="footer-name">tatenda nyemudzo.dev</p></div>
    </footer>
  </body>
</html>
