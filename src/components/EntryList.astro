---
import { Image } from 'astro:assets';
import { entryHref, formatDate, type SectionId } from '../site';
import type { Entry } from '../lib/content';
import { experimentStages } from '../lib/experiments';
interface Props { entries: Entry[]; section: SectionId; }
const { entries, section } = Astro.props;
---
<ul class:list={['entry-list', section === 'photography' && 'photo-list']}>
  {entries.map(entry => (
    <li>
      <a class="entry-link" href={entryHref(section, entry.id)}>
        {entry.collection === 'photography' && <Image src={entry.data.image} alt={entry.data.alt} width={Math.min(960, entry.data.image.width)} widths={[320, 640, 960].filter(w => w <= entry.data.image.width)} sizes="(max-width: 700px) 90vw, 45vw" format="webp" loading="lazy" />}
        <div class="entry-title-row">
          <div class="entry-title-group">
            {entry.collection === 'apps' && entry.data.logo && <Image src={entry.data.logo.image} alt={entry.data.logo.alt} width={56} height={56} class="app-logo" loading="eager" />}
            <h2>{entry.data.title}</h2>
          </div>
          {entry.data.date && <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>}
        </div>
        {entry.collection === 'music' && <p class="artist">{entry.data.artist}</p>}
        {entry.collection === 'experiments' && <p class="experiment-stage">{experimentStages[entry.data.stage].label}</p>}
        <p>{entry.data.description}</p>
      </a>
    </li>
  ))}
</ul>
