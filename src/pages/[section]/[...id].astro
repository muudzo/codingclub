---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { sections, href, formatDate } from '../../site';
import { publishedEntries, type Entry } from '../../lib/content';
import { experimentStages } from '../../lib/experiments';
export const getStaticPaths = (async () => {
  const paths = await Promise.all(sections.map(async section => (await publishedEntries(section.id)).map(entry => ({ params: { section: section.id, id: entry.id }, props: { entry } }))));
  return paths.flat();
}) satisfies GetStaticPaths;
interface Props { entry: Entry; }
const { entry } = Astro.props;
const section = sections.find(section => section.id === entry.collection)!;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="frame detail-page">
    <a class="back-link" href={href(`${section.id}/`)}>Back to {section.title.toLowerCase()}</a>
    <header class="page-heading">
      <div class="detail-title-group">
        {entry.collection === 'apps' && entry.data.logo && <Image src={entry.data.logo.image} alt={entry.data.logo.alt} width={72} height={72} class="app-logo app-logo-lg" loading="eager" />}
        <h1>{entry.data.title}</h1>
      </div>
      <p>{entry.data.description}</p>
      <div class="entry-meta">
        {entry.collection === 'experiments' && <span class="experiment-stage">{experimentStages[entry.data.stage].label}</span>}
        {entry.data.date && <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>}
        {entry.collection === 'music' && <span>{entry.data.artist}</span>}
        {entry.collection === 'apps' && entry.data.version && <span>Version {entry.data.version}</span>}
        {entry.collection === 'apps' && entry.data.platform && <span>{entry.data.platform}</span>}
      </div>
    </header>
    {entry.collection === 'photography' && <figure class="photo-figure"><Image src={entry.data.image} alt={entry.data.alt} width={Math.min(1600, entry.data.image.width)} widths={[480, 960, 1600].filter(w => w <= entry.data.image.width)} sizes="(max-width: 1280px) 90vw, 1200px" format="webp" loading="eager" />{entry.data.caption && <figcaption>{entry.data.caption}</figcaption>}</figure>}
    {entry.collection === 'apps' && <div class="download-links" aria-label="Downloads">{entry.data.downloads.map(download => <a class="button" href={download.url} rel="noopener noreferrer">{download.label}</a>)}</div>}
    {entry.collection === 'music' && <a class="button listen-link" href={entry.data.listenUrl} rel="noopener noreferrer">Listen to the song</a>}
    {entry.collection === 'experiments' && entry.data.visual && <figure class="photo-figure"><Image src={entry.data.visual.image} alt={entry.data.visual.alt} width={Math.min(1600, entry.data.visual.image.width)} widths={[480, 960, 1600, Math.min(1600, entry.data.visual.image.width)].filter((width, i, widths) => width <= entry.data.visual!.image.width && widths.indexOf(width) === i).sort((a, b) => a - b)} sizes="(max-width: 1280px) 90vw, 1200px" format="webp" loading="eager" /></figure>}
    {entry.collection === 'experiments' && (entry.data.repositoryUrl || entry.data.demoUrl) && <div class="download-links" aria-label="Project links">
      {entry.data.repositoryUrl && <a class="button" href={entry.data.repositoryUrl} rel="noopener noreferrer">View source</a>}
      {entry.data.demoUrl && <a class="button" href={entry.data.demoUrl} rel="noopener noreferrer">Try the prototype</a>}
    </div>}
    <div class="prose">
      {entry.collection === 'blog' && entry.data.plainText && entry.data.plainText.split(/\n\s*\n/).map(paragraph => <p class="post-paragraph">{paragraph}</p>)}
      <Content />
    </div>
    {entry.collection === 'blog' && entry.data.photos.length > 0 && <div class="post-photos">{entry.data.photos.map((photo, index) => <figure class="photo-figure"><Image src={photo.image} alt={photo.alt} width={Math.min(1600, photo.image.width)} widths={[480, 960, 1600, Math.min(1600, photo.image.width)].filter((width, i, widths) => width <= photo.image.width && widths.indexOf(width) === i).sort((a, b) => a - b)} sizes="(max-width: 1280px) 90vw, 1200px" format="webp" loading={index === 0 ? 'eager' : 'lazy'} /></figure>)}</div>}
  </article>
</Base>
