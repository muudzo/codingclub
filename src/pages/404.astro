---
import Base from '../layouts/Base.astro';
import { href } from '../site';
---
<Base title="Page not found" noindex>
  <section class="frame collection-page">
    <div class="page-heading"><h1>Page not found</h1><p>This page may have moved, or the address may be incomplete.</p></div>
    <a class="button" href={href()}>Back to the collection</a>
  </section>
</Base>
