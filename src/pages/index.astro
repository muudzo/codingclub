---
import Base from '../layouts/Base.astro';
import { sections, href } from '../site';
import { publishedEntries } from '../lib/content';
const collections = await Promise.all(sections.map(async section => ({ ...section, count: (await publishedEntries(section.id)).length })));
---
<Base home description="Coding, creative experiments, photography, and projects from Tatenda Nyemudzo.">
  <section class="hero frame" aria-labelledby="intro-title">
    <h1 id="intro-title">Hi, I’m<br />Tatenda.</h1>
    <div class="hero-bottom">
      <p>I like making things with technology.</p>
      <a class="button" href="#collection">Explore the collection</a>
    </div>
    <div class="intro-copy">
      <p>I enjoy coding, experimenting with new technologies, and figuring out how to make things work. My interests take me across practical apps, language tools, farming projects, and creative experiments with music.</p>
      <p>I’m curious about how technology can help with everyday problems, especially in communities I care about. This site is where I share my projects, photography, and what I’m learning along the way.</p>
    </div>
  </section>
  <section id="collection" class="collection" aria-labelledby="collection-title">
    <div class="frame">
      <div class="collection-heading"><h2 id="collection-title">The collection</h2><p>A place for what I make and what catches my attention.</p></div>
      <ul class="collection-index">
        {collections.map(section => <li><a href={href(`${section.id}/`)}><h3>{section.title}</h3><span class="collection-note">{section.note}</span><span class="collection-count">{section.count} {section.count === 1 ? section.singular : `${section.singular}s`}</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .intro-copy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 40px;
    font-size: var(--body);
  }

  .intro-copy p {
    max-width: 60ch;
  }

  @media (max-width: 800px) {
    .intro-copy {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
